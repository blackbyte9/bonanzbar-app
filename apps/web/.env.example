# Verwende den dauerhaften Neon-Branch "development" für die lokale Entwicklung.
DB_DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST/DATENBANK?sslmode=require"

# Mindestens 32 zufällige Zeichen; Preview und Production benötigen eigene Werte.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Nur in Vercel Production setzen und nach dem ersten Administrationszugang entfernen.
INITIAL_ADMIN_SETUP_TOKEN=""

# Die lokalen Demo-Rollen können damit bei Bedarf abgeschaltet werden.
DEMO_AUTH_ENABLED="true"
