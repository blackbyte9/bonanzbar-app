generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
  GUEST
}

enum CountStatus {
  DRAFT
  FINALIZED
}

enum ShoppingStatus {
  OPEN
  PURCHASED
}

enum BillStatus {
  OPEN
  PAID
}

enum PriceMode {
  PUBLIC
  HELPER
  DYNAMIC
  GUEST
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum DutyApplicationStatus {
  APPLIED
  CONFIRMED
  DECLINED
}

enum CorrectionStatus {
  PENDING
  RESOLVED
}

enum HandoverStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum HandoverPriority {
  NORMAL
  URGENT
}

enum EventLedgerEntryKind {
  INCOME
  EXPENSE
}

enum DatabaseEnvironmentName {
  DEVELOPMENT
  PREVIEW
  PRODUCTION
}

model User {
  id                    String                  @id @default(cuid())
  name                  String
  email                 String                  @unique
  roles                 Role[]                  @default([USER])
  priceMode             PriceMode               @default(DYNAMIC)
  active                Boolean                 @default(true)
  passwordHash          String?
  consumptions          Consumption[]
  bills                 Bill[]                  @relation("BillRecipient")
  dutyApplications      EventDutyApplication[]
  correctionRequests    ConsumptionCorrection[] @relation("CorrectionRequester")
  socialPosts           SocialPost[]
  approvedSocialPosts   SocialPost[]           @relation("SocialPostApprover")
  socialComments        SocialComment[]
  assignedHandoverTasks HandoverTask[]         @relation("HandoverAssignee")
  createdHandoverTasks  HandoverTask[]         @relation("HandoverCreator")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model ApplicationSetup {
  id                    String    @id @default("default")
  initialAdminCreatedAt DateTime?
}

model DatabaseEnvironment {
  id            String                  @id @default("default")
  name          DatabaseEnvironmentName
  configuredAt  DateTime                @updatedAt
}

model InventoryItem {
  id                  String                  @id @default(cuid())
  name                String
  category            String
  unit                String                  @default("bottle")
  packageSize         Int                     @default(1)
  reorderLevel        Int                     @default(0)
  priceCents          Int
  helperPriceCents    Int                     @default(0)
  guestPriceCents     Int                     @default(0)
  trackInventory      Boolean                 @default(true)
  showInMenu          Boolean                 @default(true)
  active              Boolean                 @default(true)
  countLines          StockCountLine[]
  shoppingItems       ShoppingItem[]
  consumption         Consumption[]
  billLines           BillLine[]
  correctionRequests  ConsumptionCorrection[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([name, unit])
}

model StockCount {
  id        String           @id @default(cuid())
  label     String
  status    CountStatus      @default(FINALIZED)
  countedAt DateTime         @default(now())
  createdBy String
  notes     String?
  lines     StockCountLine[]
  createdAt DateTime         @default(now())

  @@index([countedAt])
}

model StockCountLine {
  id       String        @id @default(cuid())
  countId  String
  itemId   String
  quantity Int
  count    StockCount    @relation(fields: [countId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([countId, itemId])
}

model ShoppingList {
  id        String         @id @default(cuid())
  title     String
  status    ShoppingStatus @default(OPEN)
  createdBy String
  createdAt DateTime       @default(now())
  items     ShoppingItem[]
}

model ShoppingItem {
  id                       String         @id @default(cuid())
  listId                   String
  itemId                   String?
  name                     String
  quantity                 Int
  proposedCategory         String?
  proposedUnit             String?
  proposedPackageSize      Int?
  proposedReorderLevel     Int?
  proposedPriceCents       Int?
  proposedHelperPriceCents Int?
  purchased                Boolean        @default(false)
  list                     ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  item                     InventoryItem? @relation(fields: [itemId], references: [id])
}

model Consumption {
  id           String                 @id @default(cuid())
  userId       String
  itemId       String
  quantity     Int                    @default(1)
  unitCents    Int                    @default(0)
  occurredAt   DateTime               @default(now())
  voidedAt     DateTime?
  voidedBy     String?
  correctionId String?
  user         User                   @relation(fields: [userId], references: [id])
  item         InventoryItem          @relation(fields: [itemId], references: [id])
  correction   ConsumptionCorrection? @relation(fields: [correctionId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([userId, itemId, voidedAt])
}

model BarSettings {
  id                     String   @id @default("default")
  isOfficiallyOpen       Boolean  @default(false)
  dailySpecialTitle      String?
  dailySpecialDescription String?
  dailySpecialPriceCents Int?
  dailySpecialDate       DateTime?
  dailySpecialActive     Boolean  @default(false)
  updatedBy              String?
  updatedAt              DateTime @updatedAt
}

model Bill {
  id               String          @id @default(cuid())
  recipientId      String
  status           BillStatus      @default(OPEN)
  totalCents       Int
  issuedAt         DateTime        @default(now())
  dueAt            DateTime?
  costAllocationId String?
  recipient        User            @relation("BillRecipient", fields: [recipientId], references: [id])
  costAllocation   CostAllocation? @relation(fields: [costAllocationId], references: [id], onDelete: SetNull)
  lines            BillLine[]

  @@index([costAllocationId])
}

model BillLine {
  id          String         @id @default(cuid())
  billId      String
  itemId      String?
  description String
  quantity    Int
  unitCents   Int
  bill        Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  item        InventoryItem? @relation(fields: [itemId], references: [id])
}

model BarEvent {
  id               String       @id @default(cuid())
  title            String
  description      String?
  location         String?
  bandInfo         String?
  bandHomepageUrl  String?
  bandImageUrls    String[]     @default([])
  ticketUrl        String?
  youtubeUrl       String?
  startsAt         DateTime
  endsAt           DateTime?
  status           EventStatus  @default(DRAFT)
  createdBy        String
  duties           EventDuty[]
  notes            BulletinNote[]
  recap            EventRecap?
  ledger           EventLedger?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, startsAt])
}

model EventRecap {
  id          String   @id @default(cuid())
  eventId     String   @unique
  title       String
  body        String
  imageUrls   String[] @default([])
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       BarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([published, publishedAt])
}

model SocialPost {
  id           String          @id @default(cuid())
  authorId     String
  approvedById String?
  body         String
  imageUrl     String?
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  approvedBy   User?           @relation("SocialPostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  comments     SocialComment[]

  @@index([approvedAt, createdAt])
  @@index([createdAt])
}

model SocialComment {
  id        String     @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model HandoverTask {
  id         String           @id @default(cuid())
  text       String
  assigneeId String?
  priority   HandoverPriority @default(NORMAL)
  status     HandoverStatus   @default(OPEN)
  createdBy  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  assignee   User?            @relation("HandoverAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    User             @relation("HandoverCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
}

model EventLedger {
  id        String             @id @default(cuid())
  eventId   String             @unique
  closed    Boolean            @default(false)
  closedAt  DateTime?
  closedBy  String?
  createdBy String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  event     BarEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entries   EventLedgerEntry[]
}

model EventLedgerEntry {
  id        String               @id @default(cuid())
  ledgerId  String
  label     String
  amountCents Int
  kind      EventLedgerEntryKind
  occurredAt DateTime            @default(now())
  createdBy String
  ledger    EventLedger          @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId, occurredAt])
}

model EventDuty {
  id           String                 @id @default(cuid())
  eventId      String
  label        String
  slots        Int                    @default(1)
  event        BarEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  applications EventDutyApplication[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([eventId, label])
}

model EventDutyApplication {
  id        String                @id @default(cuid())
  dutyId    String
  userId    String
  status    DutyApplicationStatus @default(APPLIED)
  note      String?
  duty      EventDuty             @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([dutyId, userId])
  @@index([userId, status])
}

model BulletinNote {
  id        String    @id @default(cuid())
  title     String
  body      String
  pinned    Boolean   @default(false)
  createdBy String
  eventId   String?
  event     BarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([pinned, createdAt])
}

model CostAllocation {
  id         String   @id @default(cuid())
  title      String
  totalCents Int
  createdBy  String
  createdAt  DateTime @default(now())
  bills      Bill[]

  @@index([createdAt])
}

model ConsumptionCorrection {
  id             String           @id @default(cuid())
  userId         String
  itemId         String
  note           String
  status         CorrectionStatus @default(PENDING)
  voidedQuantity Int              @default(0)
  response       String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation("CorrectionRequester", fields: [userId], references: [id])
  item           InventoryItem    @relation(fields: [itemId], references: [id])
  consumptions   Consumption[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
