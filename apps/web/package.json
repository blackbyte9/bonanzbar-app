{
  "name": "@bonanzbar/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-deploy.cjs && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/demo-mode-parity.test.ts tests/jimdo-program.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-with-local-env.cjs migrate dev --name development",
    "db:deploy": "node scripts/prisma-with-local-env.cjs migrate deploy",
    "db:environment": "node scripts/set-database-environment.cjs",
    "db:seed": "node scripts/prisma-with-local-env.cjs db seed"
  },
  "dependencies": {
    "@bonanzbar/shared": "*",
    "@prisma/client": "^6.4.1",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
